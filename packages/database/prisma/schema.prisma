generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  USER
}

// Geographic regions of Argentina. Only applied to Argentine provinces.
enum ArgentinaRegion {
  NOA           // Noroeste: Jujuy, Salta, Tucumán, Catamarca, La Rioja, Santiago del Estero
  NEA           // Noreste: Formosa, Chaco, Misiones, Corrientes
  CUYO          // Cuyo: Mendoza, San Juan, San Luis
  CENTRO        // Centro: Córdoba, Santa Fe, Entre Ríos
  PAMPEANA      // Pampeana: Buenos Aires (provincia), La Pampa
  METROPOLITANA // AMBA: Ciudad Autónoma de Buenos Aires + Gran Buenos Aires
  PATAGONIA     // Patagonia: Neuquén, Río Negro, Chubut, Santa Cruz, Tierra del Fuego
}

// ── Users ──────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Geography ──────────────────────────────────────────────────────────────────

model Country {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  provinces Province[]
  events    Event[]
  createdAt DateTime   @default(now())
}

model Province {
  id        Int              @id @default(autoincrement())
  name      String
  countryId Int
  country   Country          @relation(fields: [countryId], references: [id])
  region    ArgentinaRegion? // Only populated for Argentine provinces
  locations Location[]
  events    Event[]
}

model Location {
  id          Int      @id @default(autoincrement())
  name        String
  title       String?
  description String?
  provinceId  Int
  province    Province @relation(fields: [provinceId], references: [id])
  events      Event[]
}

// ── Events ─────────────────────────────────────────────────────────────────────

model Event {
  id Int @id @default(autoincrement())

  // ── Step 1: Basic info ───────────────────────────────────────────────────
  title     String
  imageUrl  String? // Cloudinary secure_url — primary image (max 5 MB)
  imageUrl2 String? // Cloudinary secure_url — secondary image (max 5 MB)

  // ── Step 2: Dates (date only — no time component) ────────────────────────
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  // duration is computed on the frontend (differenceInDays(endDate, startDate))

  // ── Step 3: Location ─────────────────────────────────────────────────────
  // region is derived from province.region — not stored redundantly on Event
  countryId  Int
  country    Country  @relation(fields: [countryId], references: [id])
  provinceId Int
  province   Province @relation(fields: [provinceId], references: [id])
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  // ── Step 4: About the event ──────────────────────────────────────────────
  description      String? // Long text: event overview
  hostChurch       String? // Long text: hosting church details
  activities       String? // Long text: scheduled activities
  extraInfo        String? // Long text: miscellaneous information
  targetAudience   String? // Long text: who can attend
  capacity         Int? // Maximum number of attendees
  registrationLink String? // External registration URL (e.g. Google Form)

  // ── Step 5: Contact ──────────────────────────────────────────────────────
  contactName  String?
  contactEmail String?
  contactPhone String? // WhatsApp international format: +54911XXXXXXXX

  // ── Step 6: Pricing (null = free event) ──────────────────────────────────
  pricing EventPricing?

  // Ownership
  createdBy String
  user      User   @relation(fields: [createdBy], references: [clerkId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Testimonials ───────────────────────────────────────────────────────────────

model Testimonial {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  avatarUrl String?
  content   String
  eventName String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Pricing ────────────────────────────────────────────────────────────────────
// Una sola modalidad de pago (definida por el equipo, 2026-10): el evento tiene
// dos montos según cuándo se abone. Las fechas límite NO se guardan — se derivan
// del inicio del evento (startDate - 2 meses / startDate - 1 mes), ver
// `apps/web/src/lib/pricing.ts`. Si el precio es único, ambos montos son iguales.

model EventPricing {
  id      Int   @id @default(autoincrement())
  eventId Int   @unique
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Monto si se paga hasta 2 meses antes del inicio del evento
  priceTwoMonthsBefore Decimal @db.Decimal(10, 2)
  // Monto si se paga hasta 1 mes antes del inicio. Siempre >= priceTwoMonthsBefore.
  priceOneMonthBefore  Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Site content (CMS) ─────────────────────────────────────────────────────────
// Textos, fotos y video de la landing editables desde el dashboard (solo ADMIN).
// Una fila por sección (`key` = hero | video | about | stats | ...). `data` es un
// JSON validado con el schema Zod de esa sección (apps/web/src/lib/content/).
// Si no existe la fila de una sección, la landing usa los defaults del código.

model SiteContent {
  key       String   @id
  data      Json
  updatedBy String? // clerkId del admin que guardó por última vez
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
